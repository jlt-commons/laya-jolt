{:paths ["src"]

 ;; data.json reads tokenizer.json / the configs / the safetensors header in
 ;; `jolt prepare`. It needs java.time at load, which jolt-lang/time provides.
 ;; ring-chez-adapter serves laya.server (jolt -M:serve / the built binary);
 ;; ruuter (a 150-line data-driven router) dispatches its routes.
 :deps {org.clojure/data.json {:mvn/version "2.5.1"}
        org.clojars.askonomm/ruuter {:mvn/version "1.3.5"}
        io.github.jolt-lang/time {:git/url "https://github.com/jolt-lang/time.git"
                                  :git/sha "abeee49974c2c4efa2fa75c96d9a379822c6815f"}
        jolt-lang/ring-chez-adapter {:git/url "https://github.com/jolt-lang/ring-chez-adapter"
                                     :git/tag "v0.7.4"
                                     :git/sha "ce4a7459dcaa33c760c0a7323026ae4c0d260bd4"}}

 ;; kernels: built from native/laya_kernels.c by the `kernels` task.
 ;; icu: NFC for the tokenizer. mac ships libicucore in the shared cache;
 ;; linux distros name it libicuuc.so.<ver>.
 ;; blas: Accelerate framework on mac, OpenBLAS elsewhere.
 ;; `jolt build` links the kernels statically from the archive so the binary
 ;; is self-contained; run/repl/test load the shared object.
 :jolt/native [{:name "laya_kernels"
                :darwin ["native/liblaya_kernels.dylib"]
                :linux  ["native/liblaya_kernels.so"]
                :static {:archive "native/liblaya_kernels.a"}}
               {:name "icu"
                :darwin ["libicucore.dylib"]
                :linux  ["libicuuc.so.76" "libicuuc.so.75" "libicuuc.so.74"
                         "libicuuc.so.72" "libicuuc.so.71" "libicuuc.so"]}
               {:name "blas"
                :darwin ["/System/Library/Frameworks/Accelerate.framework/Accelerate"]
                :linux  ["libopenblas.so.0" "libopenblas.so"]}]

 :tasks
 {:requires ([babashka.fs :as fs])

  :init (do (def mac? (some? (re-find #"^Mac" (System/getProperty "os.name"))))
            (def kern-lib (str "native/liblaya_kernels." (if mac? "dylib" "so")))
            (def kern-archive "native/liblaya_kernels.a"))

  kernels
  {:doc "compile native/laya_kernels.c into the kernel library (shared + static archive)"
   :task (if (and (fs/exists? kern-lib) (fs/exists? kern-archive)
                  (empty? (fs/modified-since kern-lib ["native/laya_kernels.c"]))
                  (empty? (fs/modified-since kern-archive ["native/laya_kernels.c"])))
           (println "kernels: up to date -" kern-lib kern-archive)
           (do (shell "cc" "-O2" "-std=c11" "-shared" "-fPIC"
                      "native/laya_kernels.c" "-o" kern-lib)
               (shell "cc" "-O2" "-std=c11" "-c" "-fPIC"
                      "native/laya_kernels.c" "-o" "native/laya_kernels.o")
               (shell "ar" "rcs" kern-archive "native/laya_kernels.o")
               (fs/delete-if-exists "native/laya_kernels.o")
               (println "built:" kern-lib kern-archive)))}

  binary
  {:doc "build the standalone HTTP server ./laya-server and self-test it against golden/"
   :depends [kernels]
   :task (do (shell "jolt" "build" "-m" "laya.server" "-o" "laya-server")
             ;; the suite runs interpreted; the AOT build must prove itself
             (shell "./laya-server" "--self-test" "--data" "data" "--golden" "golden")
             (println "built: ./laya-server  (run: ./laya-server --data data --port 8080)"))}

  prepare
  {:doc "convert the Laya checkpoint into data/ (LAYA_HOME / LAYA_DATA, ~/.config/laya/config.edn :laya-home / :data, else ../laya and data)"
   :depends [kernels]
   :task (shell "jolt" "-M:prepare")}

  clean-native
  {:doc "remove the compiled kernel library"
   :task (do (fs/delete-if-exists "native/liblaya_kernels.dylib")
             (fs/delete-if-exists "native/liblaya_kernels.so")
             (fs/delete-if-exists "native/liblaya_kernels.a")
             (println "removed kernel libs"))}}

 :aliases {:test {:extra-paths ["test"]
                  :main-opts ["-m" "laya.test-runner"]}
           :run {:main-opts ["-m" "laya.run"]}
           :prepare {:main-opts ["-m" "laya.prepare"]}
           :serve {:main-opts ["-m" "laya.server"]}}}
